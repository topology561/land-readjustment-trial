+def _k954_lin_len(geom):
+    # 🔒 `K-9-54`（`W-G.9-361`）：線長 λ(g) ＝ g 之 LineString／LinearRing 之長之和；
+    #   Multi*／GeometryCollection 逐元素下探；Point／MultiPoint（及其他非線之型）計 0。
+    #   唯為 `k6_shares_segment` 之座標容差重判所呼叫。
+    _tot = 0.0
+    _stack = [geom]
+    while _stack:
+        _g = _stack.pop()
+        if _g is None or _g.is_empty:
+            continue
+        _gt = _g.geom_type
+        if _gt in ('LineString', 'LinearRing'):
+            _tot += float(_g.length)
+        elif _gt in ('MultiLineString', 'MultiPoint', 'MultiPolygon', 'GeometryCollection'):
+            _stack.extend(list(_g.geoms))
+    return _tot
+
 
