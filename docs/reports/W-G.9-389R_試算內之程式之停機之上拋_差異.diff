+def k6_program_stop(msg):
+    """🆕 `W-G.9-389`：立程式之停機——全文登記於 `K6_PROGRAM_STOPS`（⛔ 截），回 `RuntimeError`（⛔ 拋·由呼叫端 `raise`）。"""
