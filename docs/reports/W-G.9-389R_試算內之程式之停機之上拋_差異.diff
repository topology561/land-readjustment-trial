+
+def k6_trial_mark():
+    """🆕 `W-G.9-389`：試算之前取程式之停機之登記之長度（供 `k6_trial_raise_since`）。"""
+    return len(K6_PROGRAM_STOPS)
+
+
+def k6_trial_raise_since(mark, where):
+    """🆕 `W-G.9-389`：登記之長度 ＞ `mark` ⇒ 上拋其首一新登記者之全文（⛔ 截）；否則回 `None`。"""
