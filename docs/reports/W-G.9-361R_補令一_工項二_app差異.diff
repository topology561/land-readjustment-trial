+def _k954_vtx_len(poly_a, poly_b, tol):
+    # 🔒 `K-9-54`（`W-G.9-361` 補令一 ④″-2）：界址點之讀法之共線長 L。
+    #   邊 ＝ 各環（exterior 與 interiors）相鄰二頂點所成之線段（長 0 者略）。以一方之邊 s 為軸（起點 s₀、單位方向 d、
