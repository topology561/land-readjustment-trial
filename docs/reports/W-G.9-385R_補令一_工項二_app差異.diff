+def k962_land_marks(df_rezoning, df_uland):
+    """🆕 `W-G.9-385`（`R-2`·`K-9-62` 第 3 點）：「重劃區地籍」工作表之「第33條排除」「抵充地」二欄之讀取與檢核。
+
+    回 `{'抵充地': {正規化地號: 公有持分}, '第33條排除': {正規化地號: 公有持分}, 'errors': [訊息…]}`。
+    - 二欄以欄名認之（⛔ 依位置）；二欄皆無（或 `df_rezoning` 為 `None`）⇒ 三空。
+    - 格之值去前後空白：空、`None`、`NaN`、`'nan'`、「否」⇒ 略；「是」⇒ 註記；他值 ⇒ 填列錯誤。
+    - 註記者：於 `U_LAND` 以（段小段去前導數字 ＝ 地段、地號之整數）取其列；無之 ⇒ 填列錯誤；有之 ⇒ 所有權人去重
+      （統一編號，無則姓名）後，公有持分 ＝ Σ（公私別 ＝「公」之權利範圍分子 ÷ 分母）；≤ 0（或 `df_uland` 為 `None`）
+      ⇒ 填列錯誤（非公有地）。
+    - 其正規化地號於 `df_rezoning` 見於二以上之相異地段 ⇒ 填列錯誤（無從對應宗地）。
+    - 餘 ⇒ 記 `min(公有持分, 1.0)`。錯誤之序 ＝ 逐列、逐欄（「第33條排除」→「抵充地」）；有錯誤之格⛔ 記。
+    🔧 `W-G.9-385` 補令一（`R-11`）：公有所有權人（去重後）之權利範圍之分子或分母非數值（含空白）、分母 ≤ 0、或分子 ＜ 0
+      者有一 ⇒ 填列錯誤（該格⛔ 記·⛔ 再判非公有地與二地段）；他所有權人之權利範圍⛔ 查；⛔ 拋例外。
+      其序：U_LAND 無對應資料 → 本款 → 非公有地 → 二地段。
+    """
+    out = {'抵充地': {}, '第33條排除': {}, 'errors': []}
+    if df_rezoning is None:
+        return out
+    cols = [c for c in ('第33條排除', '抵充地') if c in df_rezoning.columns]
+    if not cols:
+        return out
+
+    def _k974_cell_text(v):
+        if v is None:
+            return ''
+        try:
+            if pd.isna(v):
+                return ''
+        except (TypeError, ValueError):
+            pass
+        return str(v).strip()
+
+    # 正規化地號 → 其所見之地段（依 df_rezoning 首見之序）
+    segs_of = {}
+    for _, rz in df_rezoning.iterrows():
+        segs = segs_of.setdefault(_normalize_landno_module(_k974_cell_text(rz.get('地號'))), [])
+        seg_txt = _k974_cell_text(rz.get('地段'))
+        if seg_txt not in segs:
+            segs.append(seg_txt)
+
+    ul = None
+    if df_uland is not None:
+        ul = df_uland.copy()
+        ul['_k974_seg'] = ul['段小段'].astype(str).str.replace(r"^\d+", "", regex=True)
+        ul['_k974_no'] = pd.to_numeric(ul['地號'], errors='coerce')
+
+    for _, rz in df_rezoning.iterrows():
+        seg_txt = _k974_cell_text(rz.get('地段'))
+        no_txt = _k974_cell_text(rz.get('地號'))
+        for col in cols:
+            val = _k974_cell_text(rz.get(col))
+            if val in ('', 'nan', '否'):
+                continue
+            if val != '是':
+                out['errors'].append(f'填列錯誤：{seg_txt} {no_txt}「{col}」欄填「{val}」，僅得填「是」或空白')
+                continue
+            share = 0.0
+            if ul is not None:
+                try:
+                    if '-' in no_txt:
+                        a_txt, b_txt = no_txt.split('-', 1)
+                        no_int = int(a_txt) * 10000 + int(b_txt)
+                    else:
+                        no_int = int(no_txt) * 10000
+                except Exception:
+                    no_int = None
+                hit = ul.iloc[0:0] if no_int is None else ul[(ul['_k974_seg'] == seg_txt) & (ul['_k974_no'] == no_int)]
+                if hit.empty:
+                    out['errors'].append(f'填列錯誤：{seg_txt} {no_txt}「{col}」欄填「是」，但 U_LAND 無對應資料')
+                    continue
+                seen = set()
+                bad_frac = False
+                for _, ow in hit.iterrows():
+                    uni = _k974_cell_text(ow.get('所有權統一編號'))
+                    key = uni if uni not in ('', 'nan') else str(ow.get('姓名', '')).strip()
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    if _k974_cell_text(ow.get('公私別')) == '公':
+                        num = pd.to_numeric(ow.get('權利範圍分子'), errors='coerce')
+                        den = pd.to_numeric(ow.get('權利範圍分母'), errors='coerce')
+                        if pd.isna(num) or pd.isna(den) or den <= 0 or num < 0:
+                            bad_frac = True
+                            continue
+                        share += float(num) / float(den)
+                if bad_frac:
+                    out['errors'].append(f'填列錯誤：{seg_txt} {no_txt}「{col}」欄填「是」，'
+                                         f'但其公有所有權人之權利範圍（U_LAND 分子／分母）缺漏或分母非正數')
+                    continue
+            if share <= 0:
+                out['errors'].append(f'填列錯誤：{seg_txt} {no_txt}「{col}」欄填「是」，但該地號非公有地（U_LAND 公私別）')
+                continue
+            key_no = _normalize_landno_module(no_txt)
+            segs = segs_of.get(key_no, [])
+            if len(segs) >= 2:
+                out['errors'].append(f'填列錯誤：地號 {no_txt} 於 {"、".join(segs)} 皆有，「{col}」無從對應宗地')
+                continue
+            out[col][key_no] = min(share, 1.0)
+    return out
+
