+def k974_burden_scales(build_polys, road_polys, centerlines, front_lines, side_lines_by_side, pieces, offset_share,
+                       road_inputs, junctions=()):
+    """🆕 `W-G.9-385`（`R-4`·`K-9-74`／`K-9-79`）：各可建築街廓之正面、左側、右側之臨街地特別負擔尺度（純函式）。
+
+    逐街廓（sorted）、逐面（正面 → 左側 → 右側·無其線或線長 0 者略）：
+    ① 臨接：其線均分 `sample_n` 段，各段之中點沿法向往街廓外偏移 `sample_offset_m`；落於某道路 BLOCK 即臨之；
+       皆⛔ 落而距某道路 BLOCK 不逾 `snap_m` ⇒ 臨其最近者；餘 ⇒ ⛔ 臨（區外）。
+    ② 皆⛔ 臨 ⇒ 尺度 0；勾新闢 ⇒ 警示（`K-9-79` ②）。
+    ③ 各臨接之道路 BLOCK：無中心線 ⇒ 錯誤；垂距 ＝ 臨接諸段之平均位置之點至中心線之最近一節之直線之距離；
+       中心線之另一側、寬 ＝ 垂距之帶內之地籍（`_GHOST` 除外）之面積 ÷ 中心線之長 ＜ `fragment_avg_m` ⇒ 區界（基寬 ＝ 垂距），
+       否則基寬 ＝ 輸入之路寬；比例 ＝ 勾新闢 ⇒ 1，否則（A − B）÷ A（A ＝ 道路 BLOCK 去 `JUNCTION` 後之面積、
+       B ＝ 其內各宗地之片之面積 × 抵充地之公有持分）；垂距 × 2 與輸入路寬相差逾 `width_warn_m` ⇒ 警示；
+       負擔路寬 ＝ 基寬 × 比例 ⇒ 正面 `calc_frontage_burden_scale`、側面 `calc_side_burden_scale`。
+    ④ 一面之尺度 ＝ Σ（臨接段數 ÷ `sample_n`）× 該道路 BLOCK 之尺度（`K-9-79` ①）。
+    回 `{'scales': {街廓: {面: 尺度}}, 'detail': [列…], 'warnings': [訊息…], 'errors': [訊息…]}`；⛔ 讀 session、⛔ 停機。
+    🔧 `W-G.9-385` 補令一（`R-13`）：未勾新闢而比例 ＜ 0（抵充地之面積大於扣除路口後之面積）⇒ 錯誤、該道路 BLOCK 略之
+      （⛔ 入該面之尺度、⛔ 入明細·同 A ≤ 0 之支）。
+    """
+    from shapely.geometry import Point, Polygon, LineString
+    from shapely.ops import unary_union
+    from shapely.prepared import prep
+
+    n_smp = int(K974_PARAMS['sample_n'])
+    off_m = float(K974_PARAMS['sample_offset_m'])
+    snap_m = float(K974_PARAMS['snap_m'])
+    frag_m = float(K974_PARAMS['fragment_avg_m'])
+    face_names = K974_PARAMS['side_name']
+
+    def _k974_polygon(verts):
+        g = Polygon([(float(p[0]), float(p[1])) for p in verts])
+        return g if g.is_valid else g.buffer(0)
+
+    roads = {lb: _k974_polygon(v) for lb, v in (road_polys or {}).items()}
+    road_lbs = sorted(roads)
+    road_prep = {lb: prep(roads[lb]) for lb in road_lbs}
+    jn_polys = [_k974_polygon(j) for j in (junctions or []) if j and len(j) >= 3]
+    jn_union = unary_union(jn_polys) if jn_polys else None
+    land = [(t, _k974_polygon(t['polygon_coords'])) for t in (pieces or [])
+            if len(t.get('polygon_coords') or []) >= 3]
+    cad_cache = []          # [地籍之聯集]（首次須判區界時始求之）
+    no_land = [False]
+    scales, detail, warnings, errors = {}, [], [], []
+
+    def _k974_cad_union():
+        if not cad_cache:
+            lands = [g for t, g in land if not str(t.get('原地號', '')).startswith('_GHOST')]
+            cad_cache.append(unary_union(lands) if lands else Polygon())
+        return cad_cache[0]
+
+    for blk in sorted(build_polys or {}):
+        bpoly = _k974_polygon(build_polys[blk])
+        faces = []
+        if (front_lines or {}).get(blk):
+            faces.append(('front', front_lines[blk]))
+        sides = (side_lines_by_side or {}).get(blk) or {}
+        for sd in ('left', 'right'):
+            if sides.get(sd):
+                faces.append((sd, sides[sd]))
+        for sd, ln in faces:
+            p1 = (float(ln['p1'][0]), float(ln['p1'][1]))
+            p2 = (float(ln['p2'][0]), float(ln['p2'][1]))
+            dx, dy = p2[0] - p1[0], p2[1] - p1[1]
+            ln_len = math.hypot(dx, dy)
+            if ln_len == 0:
+                continue
+            nx, ny = -dy / ln_len, dx / ln_len
+            mx, my = (p1[0] + p2[0]) / 2.0, (p1[1] + p2[1]) / 2.0
+            if bpoly.contains(Point(mx + nx * off_m, my + ny * off_m)):
+                nx, ny = -nx, -ny
+            hits = {}
+            for i in range(n_smp):
+                t = (i + 0.5) / n_smp
+                pt = Point(p1[0] + t * dx + nx * off_m, p1[1] + t * dy + ny * off_m)
+                got = next((lb for lb in road_lbs if road_prep[lb].contains(pt)), None)
+                if got is None:
+                    near = None
+                    for lb in road_lbs:
+                        dd = roads[lb].distance(pt)
+                        if dd <= snap_m and (near is None or dd < near[0]):
+                            near = (dd, lb)
+                    got = near[1] if near else None
+                if got is not None:
+                    hits.setdefault(got, []).append(t)
+            w_in, new_in = ((road_inputs or {}).get(blk) or {}).get(sd, (0.0, False))
+            w_in = float(w_in or 0.0)
+            new_in = bool(new_in)
+            fnm = face_names[sd]
+            scales.setdefault(blk, {})
+            if not hits:
+                scales[blk][sd] = 0.0
+                if new_in:
+                    warnings.append(f'{blk} {fnm}道路勾選新闢，但未偵測到道路 BLOCK')
+                detail.append({'街廓': blk, '面': fnm, '道路': '（無）', '臨接比': 0.0, '基寬(m)': None,
+                               '比例': None, '區界在中心線': None, '垂距×2(m)': None, '負擔路寬(m)': None,
+                               '尺度': 0.0})
+                continue
+            face_total = 0.0
+            for lb in sorted(hits):
+                ts = hits[lb]
+                cl = [(float(p[0]), float(p[1])) for p in ((centerlines or {}).get(lb) or [])]
+                tm = sum(ts) / len(ts)
+                q = (p1[0] + tm * dx, p1[1] + tm * dy)
+                nearest = None
+                for k in range(len(cl) - 1):
+                    a, b = cl[k], cl[k + 1]
+                    seg_len = math.hypot(b[0] - a[0], b[1] - a[1])
+                    if seg_len == 0:
+                        continue
+                    dd = LineString([a, b]).distance(Point(q))
+                    if nearest is None or dd < nearest[0]:
+                        nearest = (dd, a, b, seg_len)
+                if nearest is None:
+                    errors.append(f'道路 BLOCK {lb} 未繪 CENTERLINE（{blk} {fnm}臨之），請補畫')
+                    continue
+                _, a, b, seg_len = nearest
+                cross = (b[0] - a[0]) * (q[1] - a[1]) - (b[1] - a[1]) * (q[0] - a[0])
+                d_perp = abs(cross) / seg_len
+                cad = _k974_cad_union()
+                if cad.is_empty:
+                    on_edge = False
+                    no_land[0] = True
+                else:
+                    cline = LineString(cl)
+                    band = cline.buffer(d_perp if cross < 0 else -d_perp, single_sided=True)
+                    on_edge = (band.intersection(cad).area / cline.length) < frag_m
+                if new_in:
+                    ratio = 1.0
+                else:
+                    rp = roads[lb] if jn_union is None else roads[lb].difference(jn_union)
+                    area_a = float(rp.area)
+                    if area_a <= 0:
+                        errors.append(f'道路 BLOCK {lb} 扣除路口後之面積為 0（{blk} {fnm}臨之）')
+                        continue
+                    area_b = 0.0
+                    for t_, g_ in land:
+                        if t_.get('所屬街廓') != lb:
+                            continue
+                        sh = float((offset_share or {}).get(_normalize_landno_module(t_.get('原地號')), 0.0))
+                        if sh:
+                            area_b += float(g_.intersection(rp).area) * sh
+                    ratio = (area_a - area_b) / area_a
+                    if ratio < 0:
+                        errors.append(f'道路 BLOCK {lb} 內抵充地之面積大於扣除路口後之面積（宗地之片重疊），'
+                                      f'請檢查地籍（{blk} {fnm}臨之）')
+                        continue
+                if w_in > 0 and abs(2 * d_perp - w_in) > K974_PARAMS['width_warn_m']:
+                    warnings.append(f'{blk} {fnm}：中心線垂距 × 2 ＝ {2 * d_perp:.2f} m，與輸入路寬 {w_in:.2f} m '
+                                    f'相差逾 {K974_PARAMS["width_warn_m"]} m，請確認')
+                base_w = d_perp if on_edge else w_in
+                bw = base_w * ratio
+                sc = calc_frontage_burden_scale(bw) if sd == 'front' else calc_side_burden_scale(bw)
+                face_total += (len(ts) / n_smp) * sc
+                detail.append({'街廓': blk, '面': fnm, '道路': lb, '臨接比': round(len(ts) / n_smp, 4),
+                               '基寬(m)': base_w, '比例': ratio, '區界在中心線': on_edge, '垂距×2(m)': 2 * d_perp,
+                               '負擔路寬(m)': bw, '尺度': sc})
+            scales[blk][sd] = face_total
+    if no_land[0]:
+        warnings.append('尚無宗地資料（地籍），中心線是否為重劃區界⛔ 判（以輸入之路寬計）')
+    return {'scales': scales, 'detail': detail, 'warnings': warnings, 'errors': errors}
+
