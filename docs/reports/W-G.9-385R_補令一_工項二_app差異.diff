+def k974_read_junctions(doc):
+    """🆕 `W-G.9-385`（`R-3`·`K-9-79` ③·`K-9-59` ⑤）：`JUNCTION` 圖層（選用之路口框）之多節線之頂點。
+
+    圖層名（不分大小寫）＝ `JUNCTION` 之 `LWPOLYLINE`／`POLYLINE`，依其序取頂點 `[(x, y), …]`；三點以上者入回傳。
+    讀取之例外 ⇒ 略該實體；`query` 本身之例外 ⇒ 回 `[]`。
+    """
+    try:
+        ents = list(doc.modelspace().query('LWPOLYLINE POLYLINE'))
+    except Exception:
+        return []
+    out = []
+    for e in ents:
+        try:
+            if str(e.dxf.layer).upper() != 'JUNCTION':
+                continue
+            if e.dxftype() == 'LWPOLYLINE':
+                pts = [(float(p[0]), float(p[1])) for p in e.get_points()]
+            else:
+                pts = [(float(v.dxf.location[0]), float(v.dxf.location[1])) for v in e.vertices]
+        except Exception:
+            continue
+        if len(pts) >= 3:
+            out.append(pts)
+    return out
+
